# 配置模板：复制为 .env 后填写实际值。
# cp .env.example .env
# 当前 ruask 不自动读取 .env，运行前执行：
# set -a; source .env; set +a

# 服务基础地址，包含服务要求的路径，例如 https://your-provider.example/v1。
# 程序会自动追加 /chat/completions，无需填写完整请求地址。
OPENAI_BASE_URL=

# 模型服务的 API 密钥；请仅在本机 .env 中填写真实密钥。
OPENAI_API_KEY=

# 服务支持的模型名称。
OPENAI_MODEL=
